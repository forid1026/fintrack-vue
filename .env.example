# Copy to .env (or set these in your hosting dashboard) before `npm run build`.

# Public URL of the deployed site (no trailing slash).
# Used for canonical + Open Graph / Twitter image tags. Optional.
VITE_SITE_URL=https://your-domain.com

# Currency symbol and number-format locale shown in the UI.
VITE_CURRENCY_SYMBOL=৳
VITE_LOCALE=en-BD
